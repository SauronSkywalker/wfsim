// THE MCP SERVER'S WORKER — mcp/index.js, at https://mcp.wfsim.app/mcp.
//
// Its own worker so the engine it bundles (`engine.js`, generated by the site
// build) never weighs on the site's cold start. Deployed by `scripts/ship.py`
// after the site, from the same commit, so its engine is the one the site
// serves. `SITE` reaches the site's worker directly for the published board.
{
  "name": "wfsim-mcp",
  "main": "index.js",
  "compatibility_date": "2026-07-28",
  "routes": [{ "pattern": "mcp.wfsim.app", "custom_domain": true }],
  "services": [{ "binding": "SITE", "service": "wfsim" }],
  // THE ALLOWANCE per minute, stated to agents as worker/agents.js MCP_LIMITS;
  // check_agents holds the two equal.
  "ratelimits": [
    { "name": "ADDRESS_LIMIT", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
    { "name": "KEY_LIMIT", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
